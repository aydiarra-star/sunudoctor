# SunuDoctor — exemple de configuration.
# NE JAMAIS COMMITTER DE SECRET RÉEL. Toutes les valeurs ci-dessous sont fictives.

# --- Application ---
APP_NAME=SunuDoctor
ENVIRONMENT=development
DEBUG=true
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Base de données ---
# Développement : SQLite. Production : PostgreSQL.
DATABASE_URL=sqlite:///./sunudoctor.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/sunudoctor

# --- CORS (origines autorisées, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend servi par l'API (déploiement un seul domaine) ---
# Laisser vide pour une API seule. Sinon, chemin vers frontend/dist.
FRONTEND_DIST=

# --- Limitation de débit ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# --- IA ---
# demo = fournisseurs synthétiques déterministes (aucune invention possible)
# live = nécessite de vraies clés ci-dessous
AI_MODE=demo
STT_PROVIDER=
STT_API_KEY=
CLINICAL_AI_PROVIDER=
CLINICAL_AI_API_KEY=
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# --- Paiements (clés strictement côté serveur) ---
PAYMENT_MODE=demo
WAVE_API_KEY=
WAVE_MERCHANT_ID=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
CARD_PROVIDER_API_KEY=
BANK_TRANSFER_ACCOUNT=

# --- Facturation ---
TRIAL_DAYS=14
CURRENCY=XOF

# --- Frontend (build) ---
# URL publique de l'API. Laisser vide en développement pour utiliser le proxy /api.
VITE_API_BASE=
# Chemin de base pour GitHub Pages (ex: /sunudoctor/). "/" pour un domaine racine.
VITE_BASE=/
